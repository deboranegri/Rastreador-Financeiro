pipeline {
    agent any

    tools { nodejs 'node20' }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {
        APP_DIR = 'rastreador-financeiro'
        CI      = 'true'
    }

    stages {
        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    bat 'npm ci --no-audit --no-fund'
                    bat 'npm run build'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: "${APP_DIR}/build/**", fingerprint: true
                }
            }
        }    
        stage('Testes') {
            steps {
                dir(env.APP_DIR) {
                    bat 'npm ci --no-audit --no-fund'
                    bat 'npm run test:ci'
                }
            }
            post {
                always {
                    junit testResults: "${APP_DIR}/reports/junit.xml"
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: "${APP_DIR}/coverage/cobertura-coverage.xml"]]
                    )
                    publishHTML(target: [
                        reportDir: "${APP_DIR}/coverage/lcov-report",
                        reportFiles: 'index.html',
                        reportName: 'Cobertura de Testes',
                        keepAll: true,
                        alwaysLinkToLastBuild: true
                    ])
                }
            }
        }
    }

    post {
        failure { echo 'Pipeline falhou - verifique o stage destacado.' }
    }
}