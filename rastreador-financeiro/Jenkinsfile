pipeline {
    agent any

    tools { nodejs 'node20' }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {
        APP_DIR    = 'rastreador-financeiro'
        DEPLOY_DIR = "${env.JENKINS_HOME}/deploy/rastreador"
        APP_PORT   = '8081'
        CI         = 'true'
    }

    stages {
        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm ci --no-audit --no-fund'
                    sh 'npm run build'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: "${APP_DIR}/build/**", fingerprint: true
                }
            }
        }

        stage('Testes') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm run test:ci'
                }
            }
            post {
                always {
                    junit testResults: "${APP_DIR}/reports/junit.xml"
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: "${APP_DIR}/coverage/cobertura-coverage.xml"]]
                    )
                    publishHTML(target: [
                        reportDir: "${APP_DIR}/coverage/lcov-report",
                        reportFiles: 'index.html',
                        reportName: 'Cobertura de Testes',
                        keepAll: true,
                        alwaysLinkToLastBuild: true
                    ])
                }
            }
        }

        stage('Deploy') {
            when { branch 'main' }
            steps {
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    rm -rf "$DEPLOY_DIR"/*
                    cp -r ${APP_DIR}/build/* "$DEPLOY_DIR"/
                    pkill -f "serve -s $DEPLOY_DIR" || true
                    JENKINS_NODE_COOKIE=dontKillMe nohup npx --yes serve -s "$DEPLOY_DIR" -l $APP_PORT > /dev/null 2>&1 &
                '''
            }
        }
    }

    post {
        success { echo "App publicado em http://localhost:${APP_PORT}" }
        failure { echo 'Pipeline falhou - verifique o stage destacado.' }
    }
}